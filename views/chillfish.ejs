<!DOCTYPE html>
<html lang="<%= lang %>" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= content.headDetails.title %></title>
    <meta name="description" content="<%= content.headDetails.description %>">
    <meta property="og:title" content="<%= content.headDetails.title %>" />
    <meta property="og:description" content="<%= content.headDetails.description %>" />
    <meta property="og:image" content="/resources/img/chillfish-logo.avif" />
    <meta property="og:type" content="website" />
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/resources/css/output-chillfish.css">
