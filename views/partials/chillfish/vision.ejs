<!-- SECTION 09 — FILOSOFÍA & VISIÓN -->
<section class="py-20 md:py-28 px-6 relative bg-[#0a0a0f]">
    <div class="max-w-4xl mx-auto relative z-10 text-center reveal-on-scroll">
        <span class="text-blue-400 font-mono text-sm tracking-widest uppercase mb-4 block"><%= content.vision.label %></span>
        <h3 class="text-2xl md:text-3xl font-light text-white mb-6"><%= content.vision.title %></h3>
        
        <div class="relative p-8 md:p-12 rounded-2xl border border-blue-500/20 bg-gradient-to-br from-blue-500/5 to-transparent">
            <span class="absolute -top-6 left-8 text-7xl font-serif text-blue-400/20 select-none">"</span>
            <blockquote class="text-xl md:text-2xl font-light text-white leading-relaxed mb-6">
                <%= content.vision.quote %>
            </blockquote>
            <p class="text-neutral-300 text-base leading-relaxed max-w-2xl mx-auto">
                <%= content.vision.text %>
            </p>
        </div>
    </div>
</section>
