<!-- SECTION 04 — PRINCIPIOS & NORMAS DE CONVIVENCIA -->
<section id="protocols-section" class="py-20 md:py-28 px-6 relative bg-[#0a0a0f]">
    <div class="max-w-5xl mx-auto">
        <div class="mb-16 text-center reveal-on-scroll">
            <span class="text-blue-400 font-mono text-sm tracking-widest uppercase mb-4 block"><%= content.values.label %></span>
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-light tracking-tight text-balance text-white mb-4"><%= content.values.title %></h2>
            <p class="text-neutral-300 text-lg max-w-2xl mx-auto"><%= content.values.description %></p>
        </div>

        <!-- Pillars Grid -->
        <div class="grid md:grid-cols-3 gap-6 md:gap-8 mb-16">
            <% content.values.pillars.forEach((pillar, index) => { %>
            <div class="group relative reveal-on-scroll" style="transition-delay: <%= index * 100 %>ms;">
                <div class="relative p-8 border border-neutral-800 rounded-2xl bg-[#12121a] h-full flex flex-col">
                    <span class="absolute top-4 right-4 font-mono text-sm text-neutral-400">0<%= index + 1 %></span>
                    
                    <div class="w-12 h-12 rounded-xl bg-blue-500/10 flex items-center justify-center mb-6">
                        <% if (index === 0) { %>
                            <i class="fas fa-volume-down text-blue-400 text-xl"></i>
                        <% } else if (index === 1) { %>
                            <i class="fas fa-eye text-blue-400 text-xl"></i>
                        <% } else { %>
                            <i class="fas fa-shield-alt text-blue-400 text-xl"></i>
                        <% } %>
                    </div>

                    <h3 class="text-xl font-medium text-white mb-3"><%= pillar.title %></h3>
                    <p class="text-neutral-300 leading-relaxed text-sm"><%= pillar.text %></p>
                </div>
            </div>
            <% }) %>
        </div>

        <!-- Specific Rules List -->
        <div class="reveal-on-scroll">
            <div class="mb-8 text-center">
                <span class="text-blue-400 font-mono text-xs tracking-widest uppercase block mb-1"><%= content.protocols.label %></span>
                <h3 class="text-2xl font-light text-white"><%= content.protocols.title %></h3>
                <p class="text-neutral-300 text-sm mt-1 max-w-xl mx-auto"><%= content.protocols.description %></p>
            </div>

            <div class="space-y-3">
                <% content.protocols.list.forEach((protocol, index) => { %>
                <div class="group relative p-5 border border-neutral-800 rounded-xl bg-[#12121a]/40 hover:bg-[#12121a] transition-colors duration-300">
                    <div class="flex flex-col md:flex-row md:items-center gap-4 justify-between">
                        <div class="flex items-center gap-4">
                            <span class="font-mono text-xs text-neutral-400">0<%= index + 1 %></span>
                            <div class="w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center shrink-0">
                                <i class="fas fa-check text-blue-400 text-xs"></i>
                            </div>
                            <div>
                                <h4 class="text-sm md:text-base font-medium text-white"><%= protocol.title %></h4>
                                <p class="text-neutral-300 text-xs md:text-sm"><%= protocol.desc %></p>
                            </div>
                        </div>
                        <div class="shrink-0">
                            <span class="inline-flex items-center gap-1.5 text-xs font-mono text-red-300 bg-red-500/10 px-3 py-1 rounded-full border border-red-500/20">
                                <span class="text-red-400">&lt;</span>
                                <%= protocol.chaos %>
                            </span>
                        </div>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>
    </div>
</section>
